{
  "name": "ball-climber",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "assets:physics": "node tools/fetch-ammo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/course.test.ts",
    "build": "npm run assets:physics && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4177",
    "test:browser": "playwright test",
    "verify": "npm run test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "playcanvas": "2.22.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
